# drop の設定サンプル。値はすべて既定値（ダミー）。秘密は不要。
# cp .env.example .env で使う。.env はコミットしない。

# 公開側の待ち受け（nginx から中継する）。loopback 必須
DROP_PUBLIC_ADDR=127.0.0.1:8470
# admin 側の待ち受け（nginx から中継しない）。loopback 必須・公開側と別にする
DROP_ADMIN_ADDR=127.0.0.1:8471

# 発行時の既定 TTL と、ttl_secs で指定できる上限（秒）
DROP_DEFAULT_TTL_SECS=600
DROP_MAX_TTL_SECS=3600

# 同時に存在できるドロップ数（未投稿を含む）と、預かり中の本文の合計バイト数
DROP_MAX_DROPS=1000
DROP_MAX_TOTAL_BYTES=1048576

RUST_LOG=info
